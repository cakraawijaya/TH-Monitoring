    {
        "id": "2e8567862d630b3e",
        "type": "function",
        "z": "c4171e1dc7d1539d",
        "g": "8ecaf2a9c1e9190c",
        "name": "prepare data to csv",
        "func": "var data = msg.payload.reverse();\nvar time = [];\nvar temperature = [];\nvar humidity = [];\n\nfor (var i = 0; i < msg.payload.length; i++) {\n\n    time[i] = new Date(msg.payload[i].unixtime * 1000).toLocaleString('en-US', {\n        timeZone: \"Asia/Jakarta\",\n        hour: \"2-digit\",\n        minute: \"2-digit\",\n        hour12: false\n    });\n\n    temperature[i] = msg.payload[i].temperature;\n    humidity[i] = msg.payload[i].humidity;\n}\n\n\n//header CSV\n\nvar csv = \"REPORT MONITORING DHT11 \" + new Date().toLocaleDateString().replace(/\\//g, '-') + \"\\n\";\ncsv += \"time,temperature,humidity\\n\";\n\nfor (var j = msg.payload.length - 1; j >= 0; j--) {\n    csv += time[j] + \",\" + temperature[j] + \",\" + humidity[j] + \"\\n\";\n}\n\nmsg.payload = csv;\n\n//directory file dan penamaan file\nvar basePath = \"C:/Users/DEVAN/.node-red/datalog/\";\nvar fileName = \"data_export\" + new Date().toLocaleString().replace(/\\//g, '-') + \".csv\";\nmsg.filename = basePath + fileName;\nflow.set('fileLocation', basePath + fileName);\n\nreturn msg;",
